SYNELIA_ENV=local
SYNELIA_DATABASE_URL=sqlite+aiosqlite:///./synelia.sqlite3
# SYNELIA_DATABASE_URL=postgresql+asyncpg://synelia:synelia@localhost:5432/synelia
# vm-admin + stack Docker dev01 : API/worker utilisent Postgres — pour `synelia seed zone-vps` depuis l'hôte :
# SYNELIA_DATABASE_URL=postgresql+asyncpg://synelia_app:<mot-de-passe>@127.0.0.1:5433/synelia
SYNELIA_SECRET=changez-moi
SYNELIA_SEED_ADMIN_EMAIL=admin@synelia.cloud
SYNELIA_SEED_ADMIN_MOT_DE_PASSE=Synelia!2026
# JSON array — quote the whole value if you `source .env` in bash
SYNELIA_CORS_ORIGINES='["http://localhost:3000"]'
# SYNELIA_TEMPORAL_ADRESSE=localhost:7233
# SYNELIA_FOURNISSEUR=openstack
# SYNELIA_OS_AUTH_URL=http://192.168.26.234:5000/v3
# Pool Web Cloud partagé (tous les hébergements sur la même zone VPS — cf. lab-openstack.md)
# Seed : `uv run synelia seed zone-vps` (après org admin + OpenStack OK)
# SYNELIA_VPS_ZONE_ESPACE_ID=
# SYNELIA_VPS_ZONE_ORG_ID=
# SYNELIA_VPS_ZONE_LB_ID=
# SYNELIA_VPS_ZONE_LB_LISTENER_ID=
# SYNELIA_OS_APPLICATION_CREDENTIAL_ID=
# SYNELIA_OS_APPLICATION_CREDENTIAL_SECRET=
# Cluster Magnum unique pour le PaaS (déploiements `kind: k8s`, observabilité) :
# SYNELIA_PAAS_CLUSTER_ID=
# Magnum create/delete : mot de passe admin (AC imbriquées interdites par Keystone) :
# SYNELIA_MAGNUM_OS_USERNAME=admin
# SYNELIA_MAGNUM_OS_PASSWORD=
# SYNELIA_MAGNUM_OS_PROJECT_NAME=admin
# Repli kubeconfig admin (chaque cluster Magnum) si /certificates est KO :
# SYNELIA_CAPI_MANAGEMENT_SSH_HOST=192.168.26.235
# SYNELIA_CAPI_MANAGEMENT_SSH_PASSWORD=
# Accélère /certificates Magnum depuis dev01 (optionnel) :
# SYNELIA_OS_ENDPOINT_OVERRIDES='{"container_infra": "http://192.168.26.234:9511/v1"}'
# Registrar réel (achat/transfert/renouvellement de domaines) : API OVH signée.
# Endpoint régional : https://eu.api.ovh.com/1.0 (ou ca./us.). Jeton créé sur
# https://api.ovh.com/createToken/ — ne JAMAIS committer les vraies valeurs.
# SYNELIA_REGISTRAR_URL=https://eu.api.ovh.com/1.0
# SYNELIA_OVH_APPKEY=
# SYNELIA_OVH_APPSECRET=
# SYNELIA_OVH_CONSUMERKEY=
# DNS posés après chaque commande de domaine (zone OVH) : A `@` + CNAME `*` vers l'edge lab.
# SYNELIA_DOMAINE_DNS_ENTREE_A=<IP publique de l entrée dev01>
# SYNELIA_DOMAINE_DNS_ENTREE_WILDCARD_CNAME=dev01.ovh.smile.ci
# Relais SMTP réel (`synelia relais-smtp`) : hôte SMTP amont vers lequel les messages autorisés
# sont relayés (Zimbra, ou tout serveur SMTP). Sans ces variables, replie sur localhost:1025.
# SYNELIA_ZIMBRA_SMTP_HOTE=
# SYNELIA_ZIMBRA_SMTP_PORT=587
# SYNELIA_SMTP_RELAIS_AMONT_IDENTIFIANT=
# SYNELIA_SMTP_RELAIS_AMONT_MOT_DE_PASSE=
# Lien webmail cliquable rendu par `POST /v1/web/emails/{id}/ouverture` (SSO preauth) :
# vhost HTTPS public qui proxie le mailboxd Zimbra interne (cf. runbook lab-openstack §
# webmail). Sans cette variable, repli sur https://webmail.cloud.dev01.ovh.smile.ci.
# SYNELIA_WEBMAIL_URL=https://webmail.cloud.dev01.ovh.smile.ci
